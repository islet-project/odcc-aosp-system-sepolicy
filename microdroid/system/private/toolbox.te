typeattribute toolbox coredomain;

init_daemon_domain(toolbox)

# Allow toolbox (sntp) to create and use UDP sockets for NTP time synchronization
allow toolbox self:udp_socket create_socket_perms_no_ioctl;

# Allow toolbox to check kernel message debug device attributes
allow toolbox kmsg_debug_device:chr_file { getattr write };

# Allow toolbox (sntp) to write to kernel log device
allow toolbox kmsg_device:chr_file write;

# Allow toolbox to use file descriptors inherited from microdroid_manager
allow toolbox microdroid_manager:fd use;

# Allow toolbox (dhcp) raw Ethernet socket for DHCP discovery phase (BOOTP before IP assigned)
allow toolbox self:packet_socket create_socket_perms_no_ioctl;

# Fix toolbox (dhcp) rawip_socket create permission
allow toolbox self:rawip_socket create_socket_perms_no_ioctl;

# Allow toolbox (dhcp) to configure network interfaces via netlink after DHCP lease
allow toolbox self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_write nlmsg_read };

# Allow toolbox (dhcp) capabilities: net_admin for interface config, net_raw for raw socket
allow toolbox self:global_capability_class_set { net_admin net_raw };

# Allow toolbox (sntp) sys_time capability for time synchronization
allow toolbox self:global_capability_class_set sys_time;

# Allow toolbox (dhcp) to discover and read network interface information
allow toolbox sysfs_net:dir { search read open };
allow toolbox sysfs_net:file { read open getattr };
allow toolbox proc_net:dir r_dir_perms;
allow toolbox proc_net:file r_file_perms;

# Allow toolbox ioctl on udp_socket (ip/ifconfig: SIOCGIFINDEX, SIOCGIFADDR, etc.)
allow toolbox self:udp_socket ioctl;
# Allow toolbox privileged ifconfig ioctls (priv_sock_ioctls not covered by domain.te)
allowxperm toolbox self:udp_socket ioctl { SIOCSIFFLAGS SIOCSIFADDR SIOCSIFBRDADDR SIOCSIFNETMASK };

# Allow toolbox ioctl on rawip_socket (dhcp: SIOCGIFFLAGS, SIOCADDRT)
allow toolbox self:rawip_socket ioctl;
# Allow toolbox privileged rawip ioctls for DHCP (SIOCGIFHWADDR=0x8927, SIOCADDRT=0x890b)
allowxperm toolbox self:rawip_socket ioctl { SIOCGIFHWADDR SIOCADDRT };

# Allow toolbox (ratls_get) outgoing HTTPS connection for model provisioning
allow toolbox self:tcp_socket { create_socket_perms_no_ioctl setopt connect name_connect getopt };
allow toolbox port:tcp_socket name_connect;

# Allow toolbox (ratls_get) rsi_device for CCA attestation token
allow toolbox rsi_device:chr_file { read write open ioctl };

# Allow toolbox (ratls_get) to read /proc/sys/vm/overcommit_memory
allow toolbox proc_overcommit_memory:file r_file_perms;

# Allow toolbox (ratls_get) to write downloaded model to encryptedstore
allow toolbox encryptedstore_file:dir { search write add_name };
allow toolbox encryptedstore_file:file { create write open getattr };

# Fix toolbox (dhcp/microdroid_dhcp) shell_exec access
allow toolbox shell_exec:file rx_file_perms;

# Allow toolbox ioctl on kmsg_debug_device (microdroid_dhcp: TCGETS)
allow toolbox kmsg_debug_device:chr_file ioctl;

# Fix toolbox (microdroid_dhcp) execute_no_trans for toolbox_exec (toybox)
allow toolbox toolbox_exec:file { execute_no_trans };

# Fix toolbox (dhcp) execute_no_trans for microdroid_dhcp_script (labeled system_file)
allow toolbox system_file:file execute_no_trans;


